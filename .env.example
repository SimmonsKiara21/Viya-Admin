# Shared desk save — phones and other computers load this snapshot from GitHub.
# Permanent classic PAT with repo + workflow. Keep it on the server as
# GITHUB_STORE_TOKEN (and on Vercel with the same name). Do not commit the value.
GITHUB_STORE_TOKEN=
GITHUB_STORE_REPO=SimmonsKiara21/Viya-Admin
GITHUB_STORE_BRANCH=main

# Square — live invoice sync (optional)
# Production invoices for this academy. Use sandbox only against a Square sandbox account.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=LC790E49DZ6B9
SQUARE_ENVIRONMENT=production

# Enrollment Google Sheet — no longer used.
# The final pull is baked into data/seed.json. Leave these blank so the desk
# cannot be overwritten if the published doc is unpublished or unlinked.
# ENROLLMENT_CSV_URL=
# ENROLLMENT_WEBHOOK_SECRET=

# Google Contacts export with Current Student / Active Subscribers / photoshoot labels
CONTACTS_LABELS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vSHzEdPAxtZVLF_qOGBK8Kd42PXfCnQGy2pmFRrIuXuLVLbqMrt76UMwIPmban9L8g1o3B3RU7eHY_9/pub?output=csv

# Textla — send desk texts from the academy Textla number
# Official path: Zapier Zap "Webhooks by Zapier (Catch Hook) → Textla Send Message"
# Map to / from_phone / message, then paste the Catch Hook URL here.
TEXTLA_WEBHOOK_URL=
TEXTLA_FROM_NUMBER=
# Optional if Textla support gave you a private send URL
TEXTLA_API_URL=

# Gmail — live email send (optional, use an app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Twilio fallback (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TEXTLA_API_KEY=

# Published student attendance tracker (Jotform → Google Sheet)
ATTENDANCE_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQCrLHIGc7NG_IAY6xd3Zlpupkjtq5NSQrRSl4W5pvTv7m6lQ1Crtqo7QIDjP3Dl5baGImT3onYQTob/pub?output=csv

# Jotform — live student check-in sync (optional extra)
# Create a key at https://www.jotform.com/myaccount/api
JOTFORM_API_KEY=

# Talent Resources (optional)
TALENT_RESOURCES_PASSWORD=
