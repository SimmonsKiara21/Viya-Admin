# Square — live invoice sync (optional)
# Production invoices for this academy. Use sandbox only against a Square sandbox account.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=LC790E490Z6B9
SQUARE_ENVIRONMENT=production

# Enrollment workbook — optional live Google Sheet published as CSV
# File → Share → Publish to web → CSV, then paste that URL here.
ENROLLMENT_CSV_URL=

# Gmail — live email send (optional, use an app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Texting — Textla or Twilio (optional)
TEXTLA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Jotform — live student check-in sync (optional)
# Create a key at https://www.jotform.com/myaccount/api
JOTFORM_API_KEY=

# Talent Resources (optional)
TALENT_RESOURCES_PASSWORD=
